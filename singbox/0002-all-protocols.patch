+
+// UpdateUsers replaces this inbound's user set while it is running.
+//
+// userNameList is indexed by the id the service returns, so it and the service
+// table are swapped under one write lock; updating them separately bills
+// traffic arriving mid-swap to the wrong user.
+func (h *Inbound) UpdateUsers(users []option.TUICUser) error {
+	userList := make([]int, 0, len(users))
+	userNameList := make([]string, 0, len(users))
+	userUUIDList := make([][16]byte, 0, len(users))
+	userPasswordList := make([]string, 0, len(users))
+	for index, user := range users {
+		if user.UUID == "" {
+			return E.New("missing uuid for user ", index)
+		}
+		parsed, err := uuid.FromString(user.UUID)
+		if err != nil {
+			return E.Cause(err, "invalid uuid for user ", index)
+		}
+		userList = append(userList, index)
+		userNameList = append(userNameList, user.Name)
+		userUUIDList = append(userUUIDList, parsed)
+		userPasswordList = append(userPasswordList, user.Password)
+	}
+	h.userAccess.Lock()
+	h.server.UpdateUsers(userList, userUUIDList, userPasswordList)
+	h.userNameList = userNameList
+	h.userAccess.Unlock()
+	return nil
+}
+
+// userName resolves the name behind a service user id. Bounds-checked because
+// the id can arrive from a connection authenticated against a longer list, and
+// indexing past the end would panic the process.
+func (h *Inbound) userName(index int) string {
+	h.userAccess.RLock()
+	defer h.userAccess.RUnlock()
+	if index < 0 || index >= len(h.userNameList) {
+		return ""
+	}
+	return h.userNameList[index]
+}
