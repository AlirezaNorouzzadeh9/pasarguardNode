diff --git a/experimental/clashapi/inbound_users.go b/experimental/clashapi/inbound_users.go
index 6242eb4..880a4be 100644
--- a/experimental/clashapi/inbound_users.go
+++ b/experimental/clashapi/inbound_users.go
@@ -25,10 +25,6 @@ import (
 // userUpdater is implemented by inbounds that can swap their user set while
 // running. The concrete user type differs per protocol, so each implementation
 // decodes the raw list itself.
-type hysteria2UserUpdater interface {
-	UpdateUsers(users []option.Hysteria2User) error
-}
-
 type updateUsersRequest struct {
 	Users json.RawMessage `json:"users"`
 }
@@ -82,19 +78,45 @@ func updateInboundUsers(server *Server) http.HandlerFunc {
 }
 
 // updateUsers decodes the raw list into the type the inbound expects and
-// applies it. Protocols are added here, one case each.
+// applies it. One case per protocol; the body is always the same shape as that
+// inbound's own users block in the config, so whatever writes the config can
+// drive this too.
 func updateUsers(inbound adapter.Inbound, raw json.RawMessage) (int, error) {
 	switch updater := inbound.(type) {
-	case hysteria2UserUpdater:
-		var users []option.Hysteria2User
-		if err := json.Unmarshal(raw, &users); err != nil {
-			return 0, err
-		}
-		if err := updater.UpdateUsers(users); err != nil {
-			return 0, err
-		}
-		return len(users), nil
+	case interface {
+		UpdateUsers([]option.Hysteria2User) error
+	}:
+		return applyUsers[option.Hysteria2User](raw, updater.UpdateUsers)
+	case interface {
+		UpdateUsers([]option.HysteriaUser) error
+	}:
+		return applyUsers[option.HysteriaUser](raw, updater.UpdateUsers)
+	case interface {
+		UpdateUsers([]option.VLESSUser) error
+	}:
+		return applyUsers[option.VLESSUser](raw, updater.UpdateUsers)
+	case interface {
+		UpdateUsers([]option.VMessUser) error
+	}:
+		return applyUsers[option.VMessUser](raw, updater.UpdateUsers)
+	case interface {
+		UpdateUsers([]option.TrojanUser) error
+	}:
+		return applyUsers[option.TrojanUser](raw, updater.UpdateUsers)
+	case interface{ UpdateUsers([]option.TUICUser) error }:
+		return applyUsers[option.TUICUser](raw, updater.UpdateUsers)
 	default:
 		return 0, newError("inbound does not support updating users: " + inbound.Type())
 	}
 }
+
+func applyUsers[T any](raw json.RawMessage, apply func([]T) error) (int, error) {
+	var users []T
+	if err := json.Unmarshal(raw, &users); err != nil {
+		return 0, err
+	}
+	if err := apply(users); err != nil {
+		return 0, err
+	}
+	return len(users), nil
+}
