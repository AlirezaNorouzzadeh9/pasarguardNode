From b32cfae6fac6a583d536d0ebd2b8a67f64b6e284 Mon Sep 17 00:00:00 2001
From: pasarguard <dev@pasarguard.local>
Date: Thu, 13 Aug 2026 09:54:37 +0000
Subject: [PATCH] feat(clashapi): let shadowsocks take users at runtime too

Its updater takes two parallel slices rather than a list of user structs, so
no single-argument case in the dispatch could ever match it and every push to
a shadowsocks inbound was refused. One inbound refusing takes the whole core
down with it, because the initial push failing stops sing-box.

The swap also had the hazard the other protocols were fixed for: the service
learns the new passwords, then the name list is replaced separately and
unlocked, so a connection authenticating in between resolves its index against
the wrong list. The lookup was unbounded too, and a shorter list panics.
---
 experimental/clashapi/inbound_users.go | 20 ++++++++++++++++++++
 protocol/shadowsocks/inbound_multi.go  | 24 ++++++++++++++++++++++--
 2 files changed, 42 insertions(+), 2 deletions(-)

diff --git a/experimental/clashapi/inbound_users.go b/experimental/clashapi/inbound_users.go
index 880a4be..75dfb31 100644
--- a/experimental/clashapi/inbound_users.go
+++ b/experimental/clashapi/inbound_users.go
@@ -105,6 +105,26 @@ func updateUsers(inbound adapter.Inbound, raw json.RawMessage) (int, error) {
 		return applyUsers[option.TrojanUser](raw, updater.UpdateUsers)
 	case interface{ UpdateUsers([]option.TUICUser) error }:
 		return applyUsers[option.TUICUser](raw, updater.UpdateUsers)
+	// shadowsocks takes two parallel slices rather than a list of user
+	// structs, so it cannot share applyUsers. The body is still the inbound's
+	// own users block, and is split here.
+	case interface {
+		UpdateUsers([]string, []string) error
+	}:
+		var users []option.ShadowsocksUser
+		if err := json.Unmarshal(raw, &users); err != nil {
+			return 0, err
+		}
+		names := make([]string, len(users))
+		passwords := make([]string, len(users))
+		for i, u := range users {
+			names[i] = u.Name
+			passwords[i] = u.Password
+		}
+		if err := updater.UpdateUsers(names, passwords); err != nil {
+			return 0, err
+		}
+		return len(users), nil
 	default:
 		return 0, newError("inbound does not support updating users: " + inbound.Type())
 	}
diff --git a/protocol/shadowsocks/inbound_multi.go b/protocol/shadowsocks/inbound_multi.go
index 7ff9264..62c5c7b 100644
--- a/protocol/shadowsocks/inbound_multi.go
+++ b/protocol/shadowsocks/inbound_multi.go
@@ -4,6 +4,7 @@ import (
 	"context"
 	"net"
 	"os"
+	"sync"
 	"time"
 
 	"github.com/sagernet/sing-box/adapter"
@@ -34,6 +35,7 @@ var (
 )
 
 type MultiInbound struct {
+	usersAccess sync.RWMutex
 	inbound.Adapter
 	ctx      context.Context
 	router   adapter.ConnectionRouterEx
@@ -123,6 +125,12 @@ func (h *MultiInbound) SetTracker(tracker adapter.SSMTracker) {
 }
 
 func (h *MultiInbound) UpdateUsers(users []string, uPSKs []string) error {
+	// Both halves under one lock. The service resolves a connection to an
+	// index and the name list turns that index into a user, so they are two
+	// halves of one fact: swapping them separately bills traffic that arrives
+	// in between to whoever now occupies that position.
+	h.usersAccess.Lock()
+	defer h.usersAccess.Unlock()
 	err := h.service.UpdateUsersWithPasswords(common.MapIndexed(users, func(index int, user string) int {
 		return index
 	}), uPSKs)
@@ -137,6 +145,18 @@ func (h *MultiInbound) UpdateUsers(users []string, uPSKs []string) error {
 	return nil
 }
 
+// userName resolves an index the service handed back, without trusting it to
+// still be in range: it can come from a connection authenticated against a
+// longer list, and indexing past the end panics the process.
+func (h *MultiInbound) userName(index int) string {
+	h.usersAccess.RLock()
+	defer h.usersAccess.RUnlock()
+	if index < 0 || index >= len(h.users) {
+		return ""
+	}
+	return h.users[index].Name
+}
+
 //nolint:staticcheck
 func (h *MultiInbound) NewConnectionEx(ctx context.Context, conn net.Conn, metadata adapter.InboundContext, onClose N.CloseHandlerFunc) {
 	err := h.service.NewConnection(ctx, conn, adapter.UpstreamMetadata(metadata))
@@ -163,7 +183,7 @@ func (h *MultiInbound) newConnection(ctx context.Context, conn net.Conn, metadat
 	if !loaded {
 		return os.ErrInvalid
 	}
-	user := h.users[userIndex].Name
+	user := h.userName(userIndex)
 	if user == "" {
 		user = F.ToString(userIndex)
 	} else {
@@ -186,7 +206,7 @@ func (h *MultiInbound) newPacketConnection(ctx context.Context, conn N.PacketCon
 	if !loaded {
 		return os.ErrInvalid
 	}
-	user := h.users[userIndex].Name
+	user := h.userName(userIndex)
 	if user == "" {
 		user = F.ToString(userIndex)
 	} else {
-- 
