+// UpdateUsers replaces the inbound's user set while it is running.
+//
+// The service's credential table and userNameList are swapped under one write
+// lock because the name list is indexed by the user id the service hands back.
+// A reader that saw the new credentials against the old names would bill
+// traffic to the wrong user, or index past the end of a shorter list.
+//
+// Connections already established keep running: their user name was resolved
+// when the connection was accepted. Removing a user stops new connections, not
+// existing ones.
+func (h *Inbound) UpdateUsers(users []option.Hysteria2User) error {
+	userList := make([]int, 0, len(users))
+	userNameList := make([]string, 0, len(users))
+	userPasswordList := make([]string, 0, len(users))
+	for index, user := range users {
+		userList = append(userList, index)
+		userNameList = append(userNameList, user.Name)
+		userPasswordList = append(userPasswordList, user.Password)
+	}
+	h.userAccess.Lock()
+	defer h.userAccess.Unlock()
+	h.service.UpdateUsers(userList, userPasswordList)
+	h.userNameList = userNameList
+	return nil
+}
+
+// userName resolves the name the service's user id refers to.
+//
+// Bounds-checked rather than indexed directly: the id comes from a connection
+// that may have authenticated against a longer user list than the one now in
+// place, and an out-of-range index here would panic the whole process.
+func (h *Inbound) userName(userID int) string {
+	h.userAccess.RLock()
+	defer h.userAccess.RUnlock()
+	if userID < 0 || userID >= len(h.userNameList) {
+		return ""
+	}
+	return h.userNameList[userID]
+}
+
