diff --git a/experimental/clashapi/inbound_users.go b/experimental/clashapi/inbound_users.go
new file mode 100644
index 0000000..6242eb4
--- /dev/null
+++ b/experimental/clashapi/inbound_users.go
@@ -0,0 +1,100 @@
+package clashapi
+
+import (
+	"encoding/json"
+	"net/http"
+
+	"github.com/sagernet/sing-box/adapter"
+	"github.com/sagernet/sing-box/option"
+
+	"github.com/go-chi/chi/v5"
+	"github.com/go-chi/render"
+)
+
+// Replacing an inbound's users without restarting.
+//
+// A panel adds and removes users continuously; restarting the process for each
+// change would drop every live connection. The protocol services underneath
+// already support having their credential table replaced at runtime - what was
+// missing is a way to ask for it from outside, which is what this provides.
+//
+// The route is generic rather than per-protocol: each inbound decodes the user
+// list into its own option type, so adding another protocol means implementing
+// one interface, not adding another endpoint.
+
+// userUpdater is implemented by inbounds that can swap their user set while
+// running. The concrete user type differs per protocol, so each implementation
+// decodes the raw list itself.
+type hysteria2UserUpdater interface {
+	UpdateUsers(users []option.Hysteria2User) error
+}
+
+type updateUsersRequest struct {
+	Users json.RawMessage `json:"users"`
+}
+
+func inboundUserRouter(server *Server) http.Handler {
+	r := chi.NewRouter()
+	r.Put("/{tag}/users", updateInboundUsers(server))
+	return r
+}
+
+// PUT /inbounds/{tag}/users
+//
+//	{"users": [{"name": "...", "password": "..."}]}
+//
+// The users array is the same shape the inbound takes in the config file, so
+// whatever generates the config can generate this without a second mapping.
+func updateInboundUsers(server *Server) http.HandlerFunc {
+	return func(w http.ResponseWriter, r *http.Request) {
+		tag := chi.URLParam(r, "tag")
+		if tag == "" {
+			render.Status(r, http.StatusBadRequest)
+			render.JSON(w, r, newError("missing inbound tag"))
+			return
+		}
+		var request updateUsersRequest
+		if err := render.DecodeJSON(r.Body, &request); err != nil {
+			render.Status(r, http.StatusBadRequest)
+			render.JSON(w, r, ErrBadRequest)
+			return
+		}
+		if server.inbound == nil {
+			render.Status(r, http.StatusInternalServerError)
+			render.JSON(w, r, newError("inbound manager unavailable"))
+			return
+		}
+		inbound, found := server.inbound.Get(tag)
+		if !found {
+			render.Status(r, http.StatusNotFound)
+			render.JSON(w, r, newError("inbound not found: "+tag))
+			return
+		}
+		count, err := updateUsers(inbound, request.Users)
+		if err != nil {
+			render.Status(r, http.StatusBadRequest)
+			render.JSON(w, r, newError(err.Error()))
+			return
+		}
+		render.Status(r, http.StatusOK)
+		render.JSON(w, r, render.M{"tag": tag, "count": count})
+	}
+}
+
+// updateUsers decodes the raw list into the type the inbound expects and
+// applies it. Protocols are added here, one case each.
+func updateUsers(inbound adapter.Inbound, raw json.RawMessage) (int, error) {
+	switch updater := inbound.(type) {
+	case hysteria2UserUpdater:
+		var users []option.Hysteria2User
+		if err := json.Unmarshal(raw, &users); err != nil {
+			return 0, err
+		}
+		if err := updater.UpdateUsers(users); err != nil {
+			return 0, err
+		}
+		return len(users), nil
+	default:
+		return 0, newError("inbound does not support updating users: " + inbound.Type())
+	}
+}
