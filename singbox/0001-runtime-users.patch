-	countUser := user != "" && s.users[user]
+	countUser := user != "" && (s.allUsers || s.users[user])
 	if !countInbound && !countOutbound && !countUser {
 		return conn
 	}
@@ -97,7 +107,7 @@ func (s *StatsService) RoutedPacketConnection(ctx context.Context, conn N.Packet
